         in the bottom mesh's local frame; middle+top share one assembly frame and stack
         onto the bottom's tenon (shoulder at 223.5mm); arm_base plates chain onto the
         foot's puzzle tabs, putting each arm exactly 116.05mm from the column center. -->
    <body name="overhead_stand" pos="0 0 0">
      <geom name="stand_bottom" type="mesh" mesh="cam_mount_bottom" pos="-0.0187 0.0365 0" euler="1.5707963 0 0" material="stand_yellow" class="visual"/>
