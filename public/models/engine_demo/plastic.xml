<mujoco model="Elastic and plastic springs">
  <option timestep=".002" gravity="0 0 0"/>
  <worldbody>
    <geom type="plane" size="3 2 .1" rgba=".14 .18 .24 1"/>
    <geom type="box" pos="0 0 .05" size=".015 .7 .05" rgba="1 1 1 1"/>
    <body name="elastic" pos="0 -.3 .2"><joint name="elastic_slide" type="slide" axis="1 0 0" stiffness="50" damping="5"/><geom type="box" size=".1 .1 .1" mass="1" rgba=".2 .7 1 1"/></body>
    <body name="plastic" pos="0 .3 .2"><joint name="plastic_slide" type="slide" axis="1 0 0" stiffness="50" damping="5" springyield=".1"/><geom type="box" size=".1 .1 .1" mass="1" rgba="1 .5 .2 1"/></body>
  </worldbody>
</mujoco>
