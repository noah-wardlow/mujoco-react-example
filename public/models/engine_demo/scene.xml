<mujoco model="Engine features">
  <compiler angle="radian"/>
  <option timestep="0.002" integrator="discrete" solver="Newton"/>
  <worldbody>
    <geom type="plane" size="3 3 .1" rgba=".14 .18 .24 1"/>
    <body name="ball" pos="-.7 0 .8" gravcomp="1">
      <joint name="ball_joint" type="ball"/>
      <geom type="box" size=".25 .06 .06" rgba=".2 .7 1 1" mass=".5"/>
      <geom type="sphere" pos=".25 0 0" size=".085" rgba="1 .6 .1 1" mass=".05"/>
      <site name="ball_target"/>
    </body>
    <body name="pid_arm" pos=".1 0 .6" gravcomp="1">
      <joint name="pid_joint" axis="0 1 0" range="-1.4 1.4"/>
      <geom type="capsule" fromto="0 0 0 0 0 .4" size=".055" rgba=".4 .9 .5 1" mass=".3"/>
    </body>
    <body name="slider" pos=".1 -.45 .15">
      <joint name="slide_joint" type="slide" axis="1 0 0" range="-.3 .3"/>
      <geom type="box" size=".08 .08 .08" rgba="1 .5 .3 1" mass=".2"/>
    </body>
    <flexcomp name="cloth" type="grid" count="9 9 1" spacing=".06 .06 .06" dim="2" pos=".85 0 1.1" mass=".08" rgba=".7 .4 1 1">
      <pin id="0 8"/><edge equality="true"/>
      <contact selfcollide="none"/>
    </flexcomp>
  </worldbody>
  <actuator>
    <orientation name="ball_servo" joint="ball_joint" input="quat" kp="20" kv="3"/>
    <pid name="pid_servo" joint="pid_joint" input="pos vel ff" kp="20" kv="3" posrange="-1.4 1.4" velrange="-2 2" ffrange="-5 5"/>
    <position name="slide_servo" joint="slide_joint" kp="30" kv="5" ctrlrange="-.3 .3"/>
  </actuator>
</mujoco>
